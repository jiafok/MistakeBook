# MistakeBook AI environment template
# Copy to deploy/.env and replace SECRET_KEY before production use.

APP_PORT=8080
SECRET_KEY=replace-with-a-random-secret-before-deploying
ALLOW_REGISTRATION=true
DEBUG=false

DATABASE_URL=sqlite:////data/mistakebook.db
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/data/storage
DATA_DIR=./data
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mistakebook
MINIO_SECURE=false

MAX_UPLOAD_FILES=500
MAX_FILE_BYTES=31457280
MAX_PDF_PAGES=100

# rapidocr is the default CPU Chinese text-recognition provider.
# Use heuristic to disable text extraction.
OCR_PROVIDER=rapidocr

AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=60

PROBABILITY_RECOMMEND=85
PROBABILITY_SUSPECT=50
DEDUP_SIMILARITY_THRESHOLD=0.90
REVIEW_INTERVALS=1,3,7,15,30

# Optional PostgreSQL profile:
# DATABASE_URL=postgresql+psycopg://mistakebook:mistakebook@postgres:5432/mistakebook
# POSTGRES_USER=mistakebook
# POSTGRES_PASSWORD=replace-this-password
# POSTGRES_DB=mistakebook
# PGDATA_DIR=./pgdata
